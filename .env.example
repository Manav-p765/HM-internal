# Copy to .env and fill in. Never commit .env.

# Postgres connection string, e.g. postgres://hm:password@localhost:5432/hm_internal
DATABASE_URL=

# Long random string used to sign session cookies (e.g. `openssl rand -hex 32`)
SESSION_SECRET=

# Public URL of the app. Used for links in emails, and mutating API requests are only
# accepted from this origin. Required in production (e.g. https://internal.hybridmonks.com).
APP_URL=http://localhost:3000

# Port the Express server listens on
PORT=4000

# Outgoing mail (new-account credentials, password resets).
# Dev: leave SMTP_HOST empty and emails are printed to the server console instead.
# Production: SMTP_HOST and SMTP_FROM are required; the server refuses to start without them.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Monks Internal <no-reply@hybridmonks.com>"
