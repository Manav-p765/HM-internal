# Copy to .env and fill in. Never commit .env.

# Postgres connection string, e.g. postgres://hm:password@localhost:5432/hm_internal
DATABASE_URL=

# Long random string used to sign session cookies (e.g. `openssl rand -hex 32`)
SESSION_SECRET=

# Public URL of the app (used for links in emails)
APP_URL=http://localhost:3000

# Port the Express server listens on
PORT=4000

# Outgoing mail (invites, password resets)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Monks Internal <no-reply@hybridmonks.com>"
