# Production environment for Monks Internal Management. Copy to .env.production (never commit it) and fill
# in every value. The server refuses to start in production if anything required is missing or looks like a
# placeholder; it names the variable but never prints the value. See docs/DEPLOY.md.

NODE_ENV=production
PORT=4000

# Public URL, exactly as users type it: https, no path, no trailing slash. Used for email links and the
# Origin check on every mutating request, so it must match what the browser sees.
APP_URL=https://internal.hybridmonks.com

# At least 32 random characters, e.g. the output of: openssl rand -hex 32
SESSION_SECRET=

# Postgres. With docker-compose.prod.yml the host is "db" and these POSTGRES_* values create the database.
POSTGRES_USER=hm
POSTGRES_PASSWORD=
POSTGRES_DB=hm_internal
DATABASE_URL=postgres://hm:POSTGRES_PASSWORD_HERE@db:5432/hm_internal

# Outgoing mail (invite links for new accounts, password reset links). Production needs SMTP_FROM and EITHER
# RESEND_API_KEY OR the SMTP_HOST/USER/PASS set below.
#
# Resend (HTTPS API): required on hosts that block outbound SMTP, such as Render's free tier (ports 25, 465
# and 587 are blocked there). When set, SMTP_* below is ignored. A key with sending access only; the domain
# of SMTP_FROM must be verified in Resend. Never logged.
RESEND_API_KEY=
#
# SMTP fallback (local runs, hosts that allow SMTP). Leave empty when RESEND_API_KEY is set.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Sender address (Resend and SMTP alike) on a domain verified at the provider (SPF/DKIM), and its display name.
SMTP_FROM=no-reply@hybridmonks.com
EMAIL_FROM_NAME=Monks Internal Management
# Optional: where replies go (a monitored inbox), since SMTP_FROM is a no-reply address. Plain address only.
SMTP_REPLY_TO=

# How many reverse proxies sit in front of the app. It decides which X-Forwarded-For entry becomes the client
# IP (rate limits and request logs use it) and lets X-Forwarded-Proto mark requests as https (secure cookies).
#   2 = Vercel in front of Render (browser -> Vercel edge -> Render proxy -> app)
#   1 = a single proxy (Render alone, or the nginx/Caddy in front of docker-compose.prod.yml)
# Too low and every user shares the proxy IP (one rate-limit bucket for everybody); too high and a client can
# pick its own IP by sending X-Forwarded-For. Also accepts true/false or a comma-separated address list.
TRUST_PROXY=1

# Optional tuning (defaults shown).
# DB_POOL_MAX=10
# DB_STATEMENT_TIMEOUT_MS=15000
# DB_IDLE_TIMEOUT_MS=30000
# DB_CONNECTION_TIMEOUT_MS=5000
# LOG_REQUESTS=true

# Backups (scripts/backup.sh)
# BACKUP_DIR=./backups
# BACKUP_KEEP=14
